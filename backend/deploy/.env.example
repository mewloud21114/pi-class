# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 32

# ---- Site --------------------------------------------------------------------
DOMAIN=piclass.example.com

# ---- Database (hex only: it goes into a connection URL) -----------------------
POSTGRES_PASSWORD=

# ---- Auth --------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=pi-class-api
JWT_AUDIENCE=pi-class-mobile
BCRYPT_ROUNDS=12

# The website is served from the same origin as the API: no CORS origins needed.
CORS_ORIGINS=

# ---- Storage: Cloudflare R2 (any S3-compatible storage works) ----------------
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=piclass-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Video/PDF links are presigned by the storage itself (bucket stays private).
MEDIA_URL_MODE=s3
MEDIA_URL_TTL_SECONDS=900
MEDIA_VIDEO_URL_TTL_SECONDS=14400

LOG_LEVEL=info
