NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://piclass:piclass@localhost:5432/piclass
DATABASE_SSL=false

# JWT — use a long random value: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-64-byte-random-hex-string-change-me-to-a-64-byte
JWT_EXPIRES_IN=7d
JWT_ISSUER=pi-class-api
JWT_AUDIENCE=pi-class-mobile

BCRYPT_ROUNDS=12

# Browser origins allowed to call the API from another host (e.g. `expo start --web` on :8081).
# Not needed for the built website, which the API serves itself on the same origin. Mobile apps send no Origin.
CORS_ORIGINS=http://localhost:8081

# Folder of the built website (mobile: npm run build:web). Defaults to ../mobile/dist.
# WEB_DIST_DIR=

# Video / PDF links given to students.
#   s3  (default): presigned URLs from the storage itself — the bucket stays private. Nothing else to set up.
#   cdn: HMAC-signed CDN URLs — only if your CDN verifies the token (e.g. Bunny token authentication).
MEDIA_URL_MODE=s3
MEDIA_URL_TTL_SECONDS=900
MEDIA_VIDEO_URL_TTL_SECONDS=14400
# cdn mode only:
# MEDIA_CDN_BASE_URL=https://cdn.example.mr
# MEDIA_SIGNING_SECRET=change-me-media-signing-secret-at-least-32-chars

# S3-compatible storage the CDN serves from. Leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=pi-class-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_URL_TTL_SECONDS=900
MAX_VIDEO_UPLOAD_BYTES=4294967296
MAX_PDF_UPLOAD_BYTES=52428800
